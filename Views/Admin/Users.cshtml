@model List<AppUser>
@{
    ViewData["Title"] = "Użytkownicy";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-people me-2"></i>Użytkownicy</h1>
            <p class="text-muted mb-0">Zarządzaj użytkownikami systemu</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Dashboard
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Użytkownik</th>
                            <th>Email</th>
                            <th>Firma</th>
                            <th>Rola</th>
                            <th>Status</th>
                            <th>Data rejestracji</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var roles = userRoles != null && userRoles.ContainsKey(user.Id) 
                                ? userRoles[user.Id] 
                                : new List<string>();
                            var isAdmin = roles.Contains("Admin");
                            <tr class="@(!user.IsActive ? "table-secondary" : "")">
                                <td>
                                    <strong>@user.FullName</strong>
                                </td>
                                <td>@user.Email</td>
                                <td>@(user.Company ?? "-")</td>
                                <td>
                                    @if (isAdmin)
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Użytkownik</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Aktywny</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Nieaktywny</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (!isAdmin)
                                    {
                                        <form asp-action="ToggleUserStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                    title="@(user.IsActive ? "Dezaktywuj" : "Aktywuj")">
                                                <i class="bi @(user.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>