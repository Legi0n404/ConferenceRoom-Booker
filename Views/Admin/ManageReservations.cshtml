@model ReservationListViewModel
@{
    ViewData["Title"] = "Zarządzanie rezerwacjami";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-calendar3 me-2"></i>Zarządzanie rezerwacjami</h1>
            <p class="text-muted mb-0">Przeglądaj i zarządzaj wszystkimi rezerwacjami</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Powrót do dashboardu
        </a>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="FilterStatus" class="form-select">
                        <option value="">Wszystkie</option>
                        <option value="0" selected="@(Model.FilterStatus == ReservationStatus.Pending)">Oczekujące</option>
                        <option value="1" selected="@(Model.FilterStatus == ReservationStatus.Approved)">Zatwierdzone</option>
                        <option value="2" selected="@(Model.FilterStatus == ReservationStatus.Rejected)">Odrzucone</option>
                        <option value="3" selected="@(Model.FilterStatus == ReservationStatus.Cancelled)">Anulowane</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Data od</label>
                    <input type="date" name="FilterDateFrom" value="@Model.FilterDateFrom?.ToString("yyyy-MM-dd")" class="form-control">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Data do</label>
                    <input type="date" name="FilterDateTo" value="@Model.FilterDateTo?.ToString("yyyy-MM-dd")" class="form-control">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Sala</label>
                    <select name="FilterRoomId" asp-items="Model.Rooms" class="form-select">
                        <option value="">Wszystkie sale</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i>Filtruj
                    </button>
                    <a asp-action="ManageReservations" class="btn btn-outline-secondary">
                        <i class="bi bi-x"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Reservations Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model.Reservations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Tytuł</th>
                                <th>Sala</th>
                                <th>Data i godzina</th>
                                <th>Użytkownik</th>
                                <th>Koszt</th>
                                <th>Status</th>
                                <th>Akcje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model.Reservations)
                            {
                                var badgeClass = res.Status switch
                                {
                                    ReservationStatus.Pending => "bg-warning text-dark",
                                    ReservationStatus.Approved => "bg-success",
                                    ReservationStatus.Rejected => "bg-danger",
                                    ReservationStatus.Cancelled => "bg-secondary",
                                    _ => "bg-secondary"
                                };
                                var statusText = res.Status switch
                                {
                                    ReservationStatus.Pending => "Oczekuje",
                                    ReservationStatus.Approved => "Zatwierdzona",
                                    ReservationStatus.Rejected => "Odrzucona",
                                    ReservationStatus.Cancelled => "Anulowana",
                                    ReservationStatus.Completed => "Zakończona",
                                    _ => "Nieznany"
                                };
                                <tr>
                                    <td>#@res.Id</td>
                                    <td>
                                        <strong>@res.Title</strong>
                                        @if (!string.IsNullOrEmpty(res.Description))
                                        {
                                            <br><small class="text-muted">@(res.Description.Length > 50 ? res.Description.Substring(0, 50) + "..." : res.Description)</small>
                                        }
                                    </td>
                                    <td>@res.Room?.Name</td>
                                    <td>
                                        @res.StartDate.ToString("dd.MM.yyyy")<br>
                                        <small>@res.StartDate.ToString("HH:mm") - @res.EndDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        @res.User?.FullName<br>
                                        <small class="text-muted">@res.User?.Email</small>
                                    </td>
                                    <td>@res.TotalCost.ToString("C", new System.Globalization.CultureInfo("pl-PL"))</td>
                                    <td><span class="badge @badgeClass">@statusText</span></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            @if (res.Status == ReservationStatus.Pending)
                                            {
                                                <form asp-action="UpdateReservationStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="Id" value="@res.Id" />
                                                    <input type="hidden" name="NewStatus" value="@ReservationStatus.Approved" />
                                                    <button type="submit" class="btn btn-success btn-sm" title="Zatwierdź">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="UpdateReservationStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="Id" value="@res.Id" />
                                                    <input type="hidden" name="NewStatus" value="@ReservationStatus.Rejected" />
                                                    <button type="submit" class="btn btn-danger btn-sm" title="Odrzuć">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                            <a asp-action="ReservationDetails" asp-route-id="@res.Id" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="mt-3 mb-0">Brak rezerwacji spełniających kryteria</p>
                </div>
            }
        </div>
    </div>
</div>